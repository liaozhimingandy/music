# 生产部署配置模板。用法：
#   cp .env.example .env && vim .env
#   docker compose pull && docker compose up -d
#
# 这个文件同时承担两个角色（compose 会自动读取同目录的 .env 做变量插值，
# 又通过 env_file 注入容器环境），所以镜像名和业务配置写在一起。
# 千万不要提交真实的 .env（已被 .gitignore 的 .env / *.env 规则挡住）。

# ---------------------------------------------------------------- 镜像来源
# 二选一：留 Docker Hub 或换成阿里云 ACR（国内服务器拉取更快、更稳）。
# tag 用 CI 打出来的具体版本（sha-xxxxxxx 或 v1.2.3）便于回滚，别长期用 latest。
#
# 注意：这两个变量只给 deploy/docker-compose.yml 用。根目录的 docker-compose.yml
# 是源码构建版，镜像名走 LOCAL_BACKEND_IMAGE / LOCAL_FRONTEND_IMAGE，不会读到
# 这里的值，避免本地 build 出来的镜像被误打上远端仓库的 tag。
BACKEND_IMAGE=docker.io/yourname/music-studio-backend:latest
FRONTEND_IMAGE=docker.io/yourname/music-studio-frontend:latest

# 阿里云 ACR 示例（个人版命名空间 + 区域域名，按实际改）：
# BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/music-studio-backend:latest
# FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/music-studio-frontend:latest

# 宿主机对外端口（再由 Nginx/Caddy 或云负载均衡做 HTTPS 终止）
WEB_PORT=8088

# ---------------------------------------------------------------- LLM
# 必填：OpenAI 兼容端点的密钥。没有它就只敢跑 mock 模式。
LLM_API_KEY=
LLM_BASE_URL=https://llm.alsoapp.com/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# 企业代理自签 CA：把证书放进 backend/app/（镜像已内置 root.crt）或挂载后写路径。
# 相对路径会按 app 目录 / backend 目录 / 仓库根依次尝试，绝对路径直接用。
# LLM_CA_CERT=root.crt

# ---------------------------------------------------------------- 音乐生成
MUSIC_API_TOKEN=
MUSIC_API_BASE_URL=https://api-inference.modelscope.cn
MUSIC_MODEL=ACE-Step/acestep-v15-xl-sft

# ---------------------------------------------------------------- 运行行为
# 生产必须是 false；true 时全部走桩，不联网也不出真歌。
MUSIC_STUDIO_MOCK=false
# 同源部署（前端 nginx 反代 /v1）时 CORS 用不上，留空即可。
# 如果前端单独部署在别的域名，填来源，逗号分隔：
# CORS_ORIGINS=https://music.example.com
CORS_ORIGINS=
# 后端在 nginx 后面：信任 X-Forwarded-For，限流才按真实 IP 统计。
MUSIC_STUDIO_TRUST_PROXY=true
# 队列并发与防护（按服务器规格与预算调；每个任务都会消耗 LLM 与音乐额度）。
MUSIC_STUDIO_MAX_ACTIVE_JOBS=4
MUSIC_STUDIO_MAX_ACTIVE_PER_CLIENT=2
MUSIC_STUDIO_RATE_LIMIT_CREATE=5
# 每日生成配额：公开演示最有效的成本闸门。默认 50 首/天，0 表示不限制；
# 用完时创建接口返回 429 + 中文提示，前端创作面板会显示剩余额度。
# 日界按 MUSIC_STUDIO_DAILY_RESET_UTC_OFFSET（默认 8 = 北京时间 00:00）。
MUSIC_STUDIO_DAILY_LIMIT=50
MUSIC_STUDIO_DAILY_RESET_UTC_OFFSET=8
# 单任务最长等待音乐生成的时间（秒）；超时会标记失败并释放队列槽位。
MUSIC_STUDIO_QUEUE_POLL_SECONDS=3
MUSIC_STUDIO_MAX_RECOVERY_ATTEMPTS=5
# 断点续跑：阶段产物存在就跳过。换了 LLM 模型想重跑时设 false（产物覆盖、
# 额度重新消耗）；否则已落盘的阶段会沿用旧模型的结果。
MUSIC_STUDIO_RESUME=true

# ---------------------------------------------------------------- 日志
# 日志写入数据卷的 /app/data/logs/music-studio-YYYY-MM-DD.log，按天轮转。
# 查日志：docker exec $(docker compose ps -q backend) tail -f /app/data/logs/$(date +%F).log
# 生产保持 false（INFO：每阶段的模型 / token / 耗时 + 失败原因足够排障）；
# 排查疑难临时设 true 会额外记录 LLM 请求参数与返回内容摘要，日志量明显变大。
DEBUG=false
# 保留天数（更早的文件由 loguru 自动删除）
MUSIC_STUDIO_LOG_RETENTION_DAYS=7
