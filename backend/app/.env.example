# 复制为 backend/app/.env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交密钥。

# LLM（OpenAI 兼容端点，用于歌曲策划 / 歌词 / 润色 / 制作方案 / 描述扩写）
LLM_BASE_URL=https://llm.alsoapp.com/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# 兼容原型里的历史变量名；也支持 OPENAI_API_KEY / LLM_API_KEY
OPENAIM_API_KEY=
# 可选：企业代理自签 CA 证书路径；文件不存在时自动回退为系统默认校验
LLM_CA_CERT=

# ModelScope ACE-Step 异步推理
MUSIC_API_BASE_URL=https://api-inference.modelscope.cn
MUSIC_MODEL=ACE-Step/acestep-v15-xl-sft
MUSIC_API_TOKEN=

# 服务
ACE_STEP_HOST=0.0.0.0
ACE_STEP_PORT=8788
# JSON 数组，例如 ["http://localhost:5177"]
# CORS_ORIGINS=

# 离线演示：设为 true 时不调用任何外部 API，用本地 mock 跑通全流程
MUSIC_STUDIO_MOCK=false

# 接口防护（防重复提交 / 防恶意刷接口；以下均为缺省值，可不填）
# 关闭后所有限流与活跃任务上限失效，仅用于本地调试，生产环境请勿关闭
# MUSIC_STUDIO_RATE_LIMIT_ENABLED=true
# 滑动窗口长度（秒）与各接口在窗口内允许的最大请求数
# MUSIC_STUDIO_RATE_LIMIT_WINDOW=60
# MUSIC_STUDIO_RATE_LIMIT_READ=180      # GET 类接口（含 2 秒一次的作品库轮询）
# MUSIC_STUDIO_RATE_LIMIT_LLM=20        # POST /api/llm（会消耗 LLM 额度）
# MUSIC_STUDIO_RATE_LIMIT_CREATE=5      # POST /api/generations（会消耗音乐生成额度）
# 全局 / 单客户端同时排队或在跑的生成任务数上限
# MUSIC_STUDIO_MAX_ACTIVE_JOBS=4
# MUSIC_STUDIO_MAX_ACTIVE_PER_CLIENT=2
# 相同请求在多少秒内视为重复提交（直接返回已有作品，不重复计费）
# MUSIC_STUDIO_DEDUPE_WINDOW=30
# 请求体大小上限（字节），超限返回 413
# MUSIC_STUDIO_MAX_REQUEST_BYTES=65536
# 仅在部署于可信反向代理之后才设为 true，否则 X-Forwarded-For 可被伪造绕过限流
# MUSIC_STUDIO_TRUST_PROXY=false
