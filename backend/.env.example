# 复制为 backend/app/.env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交密钥。

# 日志与调试（见 app/logging_setup.py）
# DEBUG=true 时日志级别为 DEBUG：会额外记录 LLM 请求参数、模型返回内容前 300 字、
# 每个阶段复用了哪个产物等细节，异常堆栈也带局部变量（可能含密钥，生产别开）。
# DEBUG=false（默认）时只记录 INFO：启停、每个阶段用了哪个模型 / 多少 token / 耗时、
# 创建与失败原因——足够排查常规问题。
# 日志文件：<data_dir>/logs/music-studio-YYYY-MM-DD.log，每天零点轮转，UTF-8。
DEBUG=false
# 关掉文件日志（只留控制台输出）
# MUSIC_STUDIO_LOG_FILE=true
# 日志保留天数（默认 7 天，更早的文件由 loguru 自动删除）
# MUSIC_STUDIO_LOG_RETENTION_DAYS=7
# 自定义日志目录（默认 <data_dir>/logs；容器里建议就用数据卷内的默认值）
# MUSIC_STUDIO_LOG_DIR=

# LLM（OpenAI 兼容端点，用于歌曲策划 / 歌词 / 润色 / 制作方案 / 描述扩写）
LLM_BASE_URL=https://llm.alsoapp.com/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# 兼容原型里的历史变量名；也支持 OPENAI_API_KEY / LLM_API_KEY
OPENAIM_API_KEY=
# 可选：企业代理自签 CA 证书（仓库里的示例放在 backend/root.crt）
# 相对路径依次按 backend/app → backend → 仓库根 → 进程 CWD 解析，
# 所以写 root.crt / .\root.crt / 绝对路径都能命中；找不到时会在启动日志里
# 打印尝试过的路径，并自动回退为系统默认证书校验。
# 注意：这是**后端出方向**用的证书——后端访问 llm.alsoapp.com 时验证网关证书；
# 浏览器访问本服务的 HTTPS 由 Traefik 的证书决定，与本项无关（见 docs/certificate.md）。
LLM_CA_CERT=

# ModelScope ACE-Step 异步推理
MUSIC_API_BASE_URL=https://api-inference.modelscope.cn
# 音乐模型 ID 的唯一来源：MusicProvider 提交的 model、prompts/music 阶段的
# target_model 校验、以及 GenerationCreate.model_variant 的缺省值都取它。
# 注意 prompts/music/system.md 的示例里写死了同一个 ID，而提示词不可修改，
# 换模型会让「阶段四」的 target_model 校验失败，请勿随意改。
MUSIC_MODEL=ACE-Step/acestep-v15-xl-sft
MUSIC_API_TOKEN=

# 本机原生启动的绑定地址（HOST / PORT 为主变量名，写了就生效；
# 兼容旧别名 MUSIC_STUDIO_HOST/PORT、ACE_STEP_HOST/PORT，不必改已有脚本）。
# scripts/start.sh|start.bat 读这里的值传给 uvicorn --host/--port。
# 默认 0.0.0.0:8788。
# 注意：**容器内固定监听 8000**（由 backend/Dockerfile 的 CMD 决定），与这里无关；
# 改容器端口要同步改 docker-compose.yml 的 ports、healthcheck 与
# Traefik server.port 三处。
HOST=0.0.0.0
PORT=8788

# 跨域：默认放行所有本机回环来源（localhost / 127.0.0.1 / [::1] 的任意端口），
# 方便前端 dev 直连任意端口的后端。
# 改了访问域名（前端和后端不同源）时，用 CORS_ORIGINS 显式列出前端来源，
# 逗号分隔或 JSON 数组均可，例如：
#   CORS_ORIGINS=https://music.openaim.cn,https://www.openaim.cn
# 注意：后端开了 allow_credentials，不能用 *，必须写具体域名；
# 多个域名用逗号分隔，端口也要写对（https 域名默认 443 可省略）。
# 也可用正则放行一类域名（把下面这项设为空可关闭「回环全放行」）：
# MUSIC_STUDIO_CORS_ORIGIN_REGEX=^https?://(?:[a-z0-9-]+\.)?openaim\.cn(?::\d+)?$

# 离线演示：设为 true 时不调用任何外部 API，用本地 mock 跑通全流程
MUSIC_STUDIO_MOCK=false

# 接口防护（防重复提交 / 防恶意刷接口；以下均为缺省值，可不填）
# 关闭后所有限流与活跃任务上限失效，仅用于本地调试，生产环境请勿关闭
# MUSIC_STUDIO_RATE_LIMIT_ENABLED=true
# 滑动窗口长度（秒）与各接口在窗口内允许的最大请求数
# MUSIC_STUDIO_RATE_LIMIT_WINDOW=60
# MUSIC_STUDIO_RATE_LIMIT_READ=180      # GET 类接口（含 2 秒一次的作品库轮询）
# MUSIC_STUDIO_RATE_LIMIT_LLM=20        # POST /v1/llm（会消耗 LLM 额度）
# MUSIC_STUDIO_RATE_LIMIT_CREATE=5      # POST /v1/generations（会消耗音乐生成额度）
# 全局 / 单客户端同时排队或在跑的生成任务数上限
# MUSIC_STUDIO_MAX_ACTIVE_JOBS=4
# MUSIC_STUDIO_MAX_ACTIVE_PER_CLIENT=2
# 每日生成配额（成本兜底）：每个自然日最多新建多少首，0 = 不限制。
# 只统计「新建」的作品，幂等重试与查询接口不吃配额；失败的任务也计数
# （失败前可能已经调用过 LLM）。超限时创建接口返回 429 + 友好中文提示。
# MUSIC_STUDIO_DAILY_LIMIT=50
# 日界所在时区相对 UTC 的偏移（小时），默认 8 = 北京时间 00:00 重置
# MUSIC_STUDIO_DAILY_RESET_UTC_OFFSET=8
# 相同请求在多少秒内视为重复提交（直接返回已有作品，不重复计费）
# MUSIC_STUDIO_DEDUPE_WINDOW=30
# 请求体大小上限（字节），超限返回 413
# MUSIC_STUDIO_MAX_REQUEST_BYTES=65536
# 仅在部署于可信反向代理之后才设为 true，否则 X-Forwarded-For 可被伪造绕过限流
# MUSIC_STUDIO_TRUST_PROXY=false

# 持久化任务队列（任务状态存 SQLite，进程重启后自动恢复）
# 启动时立即扫描一次 queued/processing 任务重新入队，之后按此间隔巡检（秒）
# MUSIC_STUDIO_QUEUE_POLL_SECONDS=3
# 同一任务最多被自动恢复几次，防止反复崩溃的任务无限消耗额度；0 = 禁用自动恢复
# 任务正常完成后计数清零，只有「连续中断」才累计
# MUSIC_STUDIO_MAX_RECOVERY_ATTEMPTS=5
# 断点续跑：阶段产物 JSON 存在就跳过该阶段（重启继续跑靠它）。
# 换了 LLM 模型想用新模型重新生成时设为 false，否则前四个阶段会直接复用旧产物，
# song_stages.model 也仍是旧模型（日志里会打「复用已落盘产物」）。
# MUSIC_STUDIO_RESUME=true
